  websiteUrl              String?
  description             String   @default("") @db.Text
  brandPortfolio          String   @default("") @db.Text
  sectoralDefinition      String   @default("") @db.Text
  naceCode                String   @default("")
  naceDescription         String   @default("")
  sasbMacroSector         String   @default("")
  sasbSubSectorSics       String   @default("")
  headquartersCountry     String   @default("")
  operationGeographies    String   @default("") @db.Text
  employeeCountTotal      Int?
  employeeCountBlueCollar Int?
  employeeCountWhiteCollar Int?
  employeeCountMale       Int?
  employeeCountFemale     Int?
  employeeContractBreakdown String @default("") @db.Text
  taxNumber               String   @default("")
  reportingCurrency       String   @default("")
  annualTurnoverMeur      Float?
  totalAssetsMeur         Float?
  legalName               String   @default("")
  employeeCountPermanent  Int?
  employeeCountTemporary  Int?
  reportingFrameworkKeys  Json     @default("[]")
  csrdScopeEmployeeCount  Int?
  csrdScopeTurnoverMeur   Float?
  csrdScopeAssetsMeur     Float?
  isPublicInterestEntity  Boolean  @default(false)
  esgSummary              Json     @default("{}")
  materialityFramework    String   @default("gri")
  materialityAssessment   Json     @default("{}")
  legacyFirebaseId        String?
  createdBy               String?
  ownerId                 String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @default(now())

  @@index([name])
  @@index([legacyFirebaseId])
  @@map("customers")
}

