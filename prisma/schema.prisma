model Assignment {
  id                          String    @id @default(cuid())
  projectId                   String
  recipientId                 String
  recipientType               String
  questionIds                 Json      @default("[]")
  token                       String?
  tokenExpiry                 DateTime?
  beginDate                   DateTime?
  deadline                    DateTime?
  /** User-selected: urgent | normal (default normal). */
  urgency                     String    @default("normal")
  message                     String    @default("") @db.Text
  sentAt                      DateTime?
  completedAt                 DateTime?
  assignedBy                  String?
  assignedByName              String?
  /** Approver (platform user or contact) for assignment-level approval. */
  approverId                  String?
  approverType                String?
  approvedAt                  DateTime?
  approvedBy                  String?
  submittedForApprovalAt      DateTime?
  status                      String    @default("pending")
  assigneeNoticeSentAt        DateTime?
  assigneeNoticeSentByUserId  String?
  assigneeNoticeSentByName    String?
  assigneeNoticeSummary       String?   @db.Text
  assigneeNoticeHasNotes      Boolean   @default(false)
  assigneeNoticeHasEvidence   Boolean   @default(false)
  assigneeNoticeItems         Json?
  /** Automated deadline reminder keys already sent (before_3d, on_due, overdue_1..3). */
  remindersSent               Json      @default("[]")
  lastReminderAt              DateTime?
  reminderCount               Int       @default(0)
  legacyFirebaseId            String?
  createdBy                   String?
  ownerId                     String?
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @default(now())

  @@index([projectId])
  @@index([recipientId])
  @@index([token])
  @@index([assignedBy])
  @@index([approverId])
  @@index([projectId, recipientId])
  @@index([projectId, status])
  @@index([deadline, status])
  @@index([legacyFirebaseId])
  @@map("assignments")
}

/** Durable log of automated assignment deadline reminder emails. */
