// GovernanceIQ relational core schema (MongoDB -> SQL migration).
//
// Provider-neutral: the same models generate on PostgreSQL and MySQL. The
// datasource `provider` and `url` are chosen per deployment via env at
// generate/build time (see prisma/README.md). Only long text uses `@db.Text`
// (valid on both engines); everything else avoids divergent native types.
//
// Design notes:
//  - PK `id` is an opaque string carrying the original Mongo `_id` hex during
//    ETL; new rows get a cuid. `legacyFirebaseId` is retained for one release
//    then dropped (see migration plan section 6 / 13).
//  - Reference fields (`customerId`, `projectId`, ...) are indexed STRING
//    columns, not declared FK relations. This matches the current app (app-side
//    joins) and avoids ETL failures on dirty legacy data. Real FKs can be added
//    per-table after the Phase 0 audit.
//  - Enum-like fields are modeled as String (app-layer validation is preserved
//    in the routes) so the dynamic CRUD API and ETL never break on unexpected
//    values.
//  - Embedded objects/arrays are `Json` (jsonb on PG, json on MySQL).
//  - createdAt/updatedAt are managed by the repository layer so the ETL can
//    preserve original timestamps (no `@updatedAt` magic).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // swap to "mysql" per deployment; keep schema provider-neutral
  url      = env("DATABASE_URL")
}

model Segment {
  id                String   @id @default(cuid())
  name              String
  type              String
  icon              String?
  legacyFirebaseId  String?
  createdBy         String?
  ownerId           String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now())

  @@index([name])
  @@index([type])
  @@index([legacyFirebaseId])
  @@map("segments")
}

model Domain {
  id                String   @id @default(cuid())
  name              String   @unique
  description       String   @default("")
  category          String   @default("esg")
  legacyFirebaseId  String?
  createdBy         String?
  ownerId           String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now())

  @@index([legacyFirebaseId])
  @@map("domains")
}

