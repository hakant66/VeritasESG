// NOTE: `kb_chunks` is the RAG search payload. On a PostgreSQL core it lives
// here with an added `embedding vector(768)` column + `tsvector` index managed
// by the vector provider via raw SQL (Prisma has no native vector type). On a
// MySQL core these rows live in a Postgres SIDECAR instead and this table is
// unused. See server/data/vector/*.
model KbChunk {
  id                String   @id @default(cuid())
  kbId              String
  documentId        String
  customerId        String?
  projectId         String?
  chunkIndex        Int
  text              String   @db.Text
  qdrantPointId     String
  embeddingModel    String
  legacyFirebaseId  String?
  createdBy         String?
  ownerId           String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now())

  @@unique([documentId, chunkIndex])
  @@index([kbId])
  @@index([documentId])
  @@index([customerId])
  @@index([projectId])
  @@index([qdrantPointId])
  @@index([legacyFirebaseId])
  @@map("kbchunks")
}

