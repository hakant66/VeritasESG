// ---------------------------------------------------------------------------
// Materiality Assessment Survey module — crowd-sourced double-materiality layer
// on top of the existing single-scorer materiality subsystem. SQL-first (no
// Mongoose models). See docs/features/materiality-survey-module-plan.md.
// Foreign keys are loose indexed strings (repo convention); cascade handled in
// server/data/materialitySurveyDataAccess.ts.
// ---------------------------------------------------------------------------

/// Survey campaign. status: draft | collecting | scoring | finalized. topicRollup: max | weighted_avg.
model MaterialitySurvey {
  id                 String    @id @default(cuid())
  customerId         String
  subeId             String?
  title              String
  standardRef        String    @default("ESRS") // GRI | ESRS | SASB
  year               Int?
  status             String    @default("draft")
  deadline           DateTime?
  scaleMax           Int       @default(5)
  topicRollup        String    @default("max") // max | weighted_avg
  materialThreshold  Float?
  reminderCadence    Json      @default("[3, 7]") // days-after-invite for each reminder
  reminderCutoffDays Int       @default(14)
  maxReminders       Int       @default(3)
  isTemplate         Boolean   @default(false)
  legacyFirebaseId   String?
  createdBy          String?
  ownerId            String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @default(now())

  @@index([customerId])
  @@index([customerId, status])
  @@index([isTemplate])
  @@index([legacyFirebaseId])
  @@map("materialitysurveys")
}

/// Impact / Risk / Opportunity under a topic, within a survey.
model MaterialityIro {
  id                 String   @id @default(cuid())
  surveyId           String
  topicRef           String   // GRIMaterialityMatrixRow.id (longlist row)
  description        String   @default("") @db.Text
  iroType            String   @default("impact") // impact | risk | opportunity
  valueChainPosition String   @default("own_operations") // own_operations | upstream | downstream
  polarity           String   @default("negative") // positive | negative
  sasbRef            String?
  esrsRef            String?
  sortOrder          Int      @default(0)
  legacyFirebaseId   String?
  createdBy          String?
  ownerId            String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now())

  @@index([surveyId])
  @@index([surveyId, topicRef])
  @@index([legacyFirebaseId])
  @@map("materialityiros")
}

/// Weighted stakeholder group within a survey.
model MaterialityStakeholderGroup {
  id               String   @id @default(cuid())
  surveyId         String
  name             String
  weight           Float    @default(1.0)
  sortOrder        Int      @default(0)
  legacyFirebaseId String?
  createdBy        String?
  ownerId          String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now())

  @@index([surveyId])
  @@index([legacyFirebaseId])
  @@map("materialitystakeholdergroups")
}

/// Individual stakeholder + tokenized invite. status: invited | reminded | completed | expired.
model MaterialityStakeholder {
  id               String    @id @default(cuid())
  groupId          String
  name             String
  email            String
  phone            String?
  locale           String    @default("tr") // tr | en
  inviteToken      String    @unique
  status           String    @default("invited")
  invitedAt        DateTime?
  completedAt      DateTime?
  legacyFirebaseId String?
  createdBy        String?
  ownerId          String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @default(now())

  @@index([groupId])
  @@index([status])
  @@index([legacyFirebaseId])
  @@map("materialitystakeholders")
}

/// One stakeholder's double-materiality scoring of one IRO. Upsert on (iroId, stakeholderId).
model MaterialitySurveyResponse {
  id                        String   @id @default(cuid())
  iroId                     String
  stakeholderId             String
  financialMaterialityScore Int      @default(0)
  impactSeverityScore       Int      @default(0)
  impactScopeScore          Int      @default(0)
  impactProbabilityScore    Int      @default(0)
  irremediabilityScore      Int?
  freeTextComment           String   @default("") @db.Text
  submittedAt               DateTime @default(now())
  legacyFirebaseId          String?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @default(now())

  @@unique([iroId, stakeholderId])
  @@index([iroId])
  @@index([stakeholderId])
  @@map("materialitysurveyresponses")
}

/// Idempotent reminder audit; unique (stakeholderId, reminderNumber) blocks double sends.
model MaterialitySurveyReminderLog {
  id             String   @id @default(cuid())
  stakeholderId  String
  channel        String   @default("email")
  reminderNumber Int
  sentAt         DateTime @default(now())
  createdAt      DateTime @default(now())

  @@unique([stakeholderId, reminderNumber])
  @@index([stakeholderId])
  @@map("materialitysurveyreminderlogs")
}
