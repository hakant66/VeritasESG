  ownerId         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now())

  @@unique([assignmentId, reminderKey])
  @@index([assignmentId])
  @@index([projectId])
  @@index([sentAt])
  @@index([legacyFirebaseId])
  @@map("assignmentreminderlogs")
}

