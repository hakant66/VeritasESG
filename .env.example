PORT=3010
# Optional: max JSON body size for API (large template question imports). Default in server is 32mb.
# JSON_BODY_LIMIT=32mb
APP_PUBLIC_URL=http://localhost:3010
# In production/Docker set this to your public app URL (e.g. https://giq.theleadai.co.uk).
# If left as localhost, assignment resend emails use PASSWORD_RESET_PUBLIC_URL when set.
# Avatar public URLs default to {APP_PUBLIC_URL}/storage/{S3_BUCKET}/… (proxied by the app to MinIO).
# Legacy CDN hostnames in avatarUrl are rewritten on read (default: cdn.impact-ai.co.uk).
# S3_PUBLIC_URL_BASE=https://giq.theleadai.co.uk/storage/governance-uploads
# S3_LEGACY_CDN_HOSTS=cdn.impact-ai.co.uk
# Optional: force the base URL used in password-reset emails (overrides Origin / client hint). Use in prod if needed.
PASSWORD_RESET_PUBLIC_URL=https://giq.impact-ai.co.uk
PASSWORD_RESET_EXPIRES_IN=1h
# Platform session JWT (email/password + OTP login). jsonwebtoken `expiresIn` format, e.g. 1d, 12h, 3600
# AUTH_TOKEN_EXPIRES_IN=1d
# Contact magic-link / response token from /api/auth/generate-token
# CONTACT_RESPONSE_TOKEN_EXPIRES_IN=7d
# Email OTP code lifetime in minutes (1–1440)
# AUTH_OTP_CODE_EXPIRES_MINUTES=10
# Optional: extra browser origins for CORS (comma-separated). Defaults include localhost and https://giq.impact-ai.co.uk
CORS_ALLOWED_ORIGINS=https://giq.impact-ai.co.uk,https://giq.g2m.partners

# --- Relational core (PostgreSQL is the primary and only supported datastore) ---
# Prisma relational core connection (choose engine via `npm run db:provider <postgresql|mysql>`):
DATABASE_URL=postgresql://governance:governance@localhost:5442/governance
# DATABASE_URL=mysql://user:pass@localhost:3306/governance
# STAGING_DATABASE_URL=postgresql://user:pass@staging-host:5432/governance_migration
# SKIP_SQL_SETUP=1   # skip schema push when target DB already provisioned
# RAG vector store: pgvector (default) | qdrant | disabled
VECTOR_BACKEND=pgvector
# Postgres holding kb_chunks + embeddings. Reuse DATABASE_URL on a Postgres core;
# point at a Postgres sidecar when the core is MySQL. Unset => semantic RAG disabled.
VECTOR_DATABASE_URL=postgresql://governance:governance@localhost:5442/governance
JWT_SECRET=replace-with-a-long-random-secret
PLATFORM_API_KEY=replace-with-platform-api-key

RESEND_API_KEY=re_replace-with-resend-api-key
RESEND_FROM_NAME=Impact AI VeritasESG
# Must use an address on a verified domain in Resend (theleadai.co.uk is verified).
RESEND_FROM_EMAIL=no-reply@theleadai.co.uk
# Optional reply-to for transactional mail
# RESEND_REPLY_TO_EMAIL=support@theleadai.co.uk
# RESEND_REPLY_TO_NAME=Impact AI Support

# Automated task (assignment) deadline reminders: 3 days before, on due date,
# and daily for 3 days after overdue. Cron uses server local time (UTC in Docker).
# ASSIGNMENT_REMINDERS_ENABLED=true
# ASSIGNMENT_REMINDERS_CRON=0 8 * * *
# ASSIGNMENT_REMINDER_TZ=Europe/Istanbul

# Materiality survey reminder sweep (in-process cron; SQL-only). Emails pending
# stakeholders per each survey's reminderCadence until they respond or expire.
# MATERIALITY_SURVEY_REMINDERS_ENABLED=true
# MATERIALITY_SURVEY_REMINDERS_CRON=0 9 * * *
# MATERIALITY_SURVEY_REMINDER_TZ=Europe/Istanbul

# Resend webhook (delivery / bounce tracking → Sistem Denetimi)
# Resend dashboard → Webhooks → endpoint: https://your-domain/api/webhooks/resend
# Events: email.sent, email.delivered, email.bounced, email.complained, email.delivery_delayed, email.failed
# Copy signing secret from webhook details:
# RESEND_WEBHOOK_SECRET=whsec_replace-with-webhook-signing-secret
# Dev fallback (unsigned): RESEND_WEBHOOK_TOKEN=replace-with-long-random-token

GEMINI_API_KEY=replace-with-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
# Optional fallbacks until configured in Settings → LLM (app setting key: llm)
# OPENAI_API_KEY=replace-with-openai-api-key
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=replace-with-anthropic-api-key
# AI_PROVIDER=gemini

# --- Knowledge-base RAG (Qdrant + Redis + embeddings) ---
# Local stack: docker compose up (includes redis:6379 and qdrant:6333)
# REDIS_URL=redis://localhost:6379
# QDRANT_URL=http://127.0.0.1:6333
# KB_EMBEDDING_MODEL=gemini-embedding-001
# KB_EMBEDDING_DIMENSIONS=768
# KB_CHUNK_TARGET_CHARS=1500
# KB_CHUNK_OVERLAP_CHARS=200
# Hybrid retrieval (vector + Postgres keyword search on kb_chunks.text). Default: false (vector-only).
# Recommended for production: true (see docs/prod-env-template.md)
KB_HYBRID_SEARCH_ENABLED=true
# KB_SEARCH_RETRIEVE_LIMIT=24
# KB_RRF_K=60
# Cohere rerank (recommended for production retrieval quality). When COHERE_API_KEY is set, rerank auto-enables unless RERANK_PROVIDER=none.
# COHERE_API_KEY=replace-with-cohere-api-key
# RERANK_MODEL=rerank-v3.5
# RERANK_TOP_N=8
# Explicit override: RERANK_PROVIDER=cohere | ollama | none

# --- GPU host + Ollama LLM (see docs/ollama-gpu-host-setup.md, docs/prod-env-template.md) ---
# AI_PROVIDER=ollama
# OLLAMA_BASE_URL=http://192.168.1.50:11434
# OLLAMA_TEXT_MODEL=llama3.2
# EMBEDDING_PROVIDER=openai
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# OLLAMA_EMBEDDING_DIMENSIONS=768
VITE_GEMINI_API_KEY=replace-with-browser-gemini-api-key
VITE_GEMINI_MODEL=gemini-2.5-flash
# Optional: text model for chat and other generateContent calls (default: gemini-2.5-flash). Either name works in the client bundle.
# Retired ids (e.g. gemini-1.5-flash-latest) are rewritten to the default at runtime.

# Login page (Vite client — rebuild after change). URL query overrides env; with HashRouter use #/login?…
# VITE_LOGIN_TITLE=VeritasESG
# VITE_LOGIN_TAGLINE=Consultancy governance platform
# VITE_LOGIN_LOGO_RECT_URL=https://…/logo-wide.png
# VITE_LOGIN_LOGO_SQUARE_URL=https://…/logo-square.png
# VITE_LOGIN_THEME=default
# Allowed themes: default | dark | slate | brand
# VITE_LOGIN_DOCUMENT_TITLE=Sign in
# Default login UI language (en | tr). Per-visit override: #/login?lang=tr (stored in session until changed)
# VITE_LOGIN_LANG=en

# --- Object storage (S3-compatible) — optional for profile images over ~350KB ---
# Local MinIO (see docker-compose.minio.yml): start stack, then use path-style + LAN endpoint from the Node process.
# S3_BUCKET=governance-uploads
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_FORCE_PATH_STYLE=true
# If the browser cannot reach 127.0.0.1:9000 (e.g. app opened from another device), set a reachable base URL
# (reverse proxy or host LAN IP) so avatarUrl links work: same path as path-style public object URL.
# S3_PUBLIC_URL_BASE=http://127.0.0.1:9000/governance-uploads
# Required for MinIO: without S3_ENDPOINT the SDK talks to AWS and returns "Access Key Id does not exist".
# --- AWS S3 (alternate) ---
# S3_BUCKET=your-bucket-name
# S3_REGION=eu-west-2
# S3_ACCESS_KEY_ID=AKIA...
# S3_SECRET_ACCESS_KEY=...
# Omit S3_ENDPOINT and S3_FORCE_PATH_STYLE for virtual-hosted-style AWS URLs (or set endpoint if using a custom S3 API).
